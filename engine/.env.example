# Copy to engine/.env (git-ignored) or export in the shell that starts uvicorn. Every line is optional; without it the door stays shut and the app says so.
# Words from a model (chat, feedback polish, photo description, free-text understanding): one of
ANTHROPIC_API_KEY=            # Claude API, model claude-opus-5-5
# or AWS credentials plus AWS_REGION for Claude on Amazon Bedrock (SCARLETWELL_BEDROCK_MODEL, BEDROCK_GUARDRAIL_ID optional); Comprehend Medical uses the same credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Voice in and out on Chat (mic button, Read aloud, Spanish)
ELEVENLABS_API_KEY=
# Screen model replies and chat text with Azure AI Content Safety (medium severity or higher: template reply, CAPS and 988 line)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
# Rutgers email code by mail: Azure Communication Services, or any SMTP relay
ACS_CONNECTION_STRING=
ACS_FROM=DoNotReply@<your-domain>.azurecomm.net
SMTP_URL=                     # smtp://user:pass@host:587 or smtps://...
# Live sign-in to wearables and Google Calendar (one registered app per maker; Google Fit and Calendar share one)
WEARABLE_REDIRECT=http://localhost:8000/wearables/callback
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
GOOGLEFIT_CLIENT_ID=
GOOGLEFIT_CLIENT_SECRET=
# Registry refresh from Rutgers pages
ANAKIN_API_KEY=
