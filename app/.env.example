# Copy to app/.env.local (git-ignored). Browser keys only; restrict each to your referrers in its console.
VITE_USE_FIXTURES=0                 # 0 = talk to the engine at VITE_API_URL; unset or 1 = fixtures only
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=           # Google Maps on the landing page, Nearby and Feedback; OpenStreetMap without it (or paste it once on the page)
VITE_AZURE_MAPS_KEY=                # Azure Maps heat layer of need on the ScarletWell view
